# Every variable the repository reads, by tier (REPO-BASELINE §2). Copy to .env (gitignored)
# only if you run a service outside the AppHost; under the AppHost most of these are injected.
# Tiers: always = required to start | mode = required for one deployment mode | secret = never
#        in source, set via user-secrets / platform secrets | ci = CI only | tuning = optional.
# Every secret here is dev-only. Nothing in this file is, or may become, a real credential.

# --- interview-service -------------------------------------------------------------------
# tier: tuning. PostgreSQL | (empty). Empty or no connection string => InMemory provider.
# Degrades to: in-memory data, lost on restart. /health reports database=inmemory.
DATABASE_PROVIDER=
# tier: secret (mode: PostgreSQL). Under the AppHost this is injected.
ConnectionStrings__interviewdb=
# tier: mode (identity). Public base URL of this system's authservice instance.
# Degrades to: protected endpoints answer 401; /health reports identity=not-configured.
Jwt__Authority=
# tier: mode (identity). Must equal the issuer/audience configured on the authservice instance.
Jwt__Issuer=ExitInterviewAgent
Jwt__Audience=ExitInterviewAgent
# tier: tuning. Browser origin(s) allowed by CORS (the BFF is same-origin, so usually unset).
Cors__AllowedOrigins__0=
# tier: tuning. OTLP endpoint; unset => no export (in-process telemetry only).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- AppHost (read from dotnet user-secrets by scripts/setup.*) -------------------------
# tier: secret. PKCS#8 PEM, DEV ONLY. The authservice instance signs with it; nothing else
# holds it. Unset => the AppHost generates an ephemeral dev key per run.
# (user-secrets key: Parameters:authservice-jwt-private-key)

# --- web (Next.js BFF) ------------------------------------------------------------------
# tier: mode. Backend addresses, read per request by /api/config and the proxy.
# Under the AppHost the service-discovery variables (services__*) are used instead.
INTERVIEW_SERVICE_URL=
# tier: mode (identity). authservice address, issuer and audience the middleware verifies.
AUTH_SERVICE_URL=
AUTH_ISSUER=ExitInterviewAgent
AUTH_AUDIENCE=ExitInterviewAgent
# tier: tuning. Set to "false" only for plain-http local development.
SESSION_COOKIE_SECURE=

# --- CI ---------------------------------------------------------------------------------
# tier: ci. Deployment is out of scope for this phase: no FLY_API_TOKEN is configured anywhere.
# See flyio/SECRETS.md for what a future deployment would need.

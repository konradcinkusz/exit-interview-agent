{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Interviews": {
    "Enabled": true,
    "Provider": "",
    "RequireCredit": false,
    "IdleTimeout": "00:30:00",
    "ResultTtl": "00:30:00",
    "TurnTimeout": "00:01:00",
    "RequireVerifiedEmail": true,
    "MaxStartsPerDay": 20,
    "RateLimits": {
      "StartsPerAccountPerHour": 5,
      "StartsPerIpPerHour": 20,
      "RepliesPerAccountPerMinute": 30,
      "RepliesPerIpPerMinute": 60
    }
  }
}

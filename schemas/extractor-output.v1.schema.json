{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exit-interview-agent:schema:extractor-output:v1",
  "title": "Record extractor output, version 1",
  "description": "What the record-extractor model must return: one entry per topic, nothing else. No sentiment, emotion or affect field and no identifier of any kind: ratings are about the employer's practices, quotes are verbatim excerpts of the masked transcript. The agent builds the interview record from this with its own code (docs/architecture/interview-agent.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onboarding", "management", "growth", "pay_vs_promises", "culture", "reason_for_leaving"],
      "properties": {
        "onboarding": { "$ref": "#/$defs/topic" },
        "management": { "$ref": "#/$defs/topic" },
        "growth": { "$ref": "#/$defs/topic" },
        "pay_vs_promises": { "$ref": "#/$defs/topic" },
        "culture": { "$ref": "#/$defs/topic" },
        "reason_for_leaving": { "$ref": "#/$defs/topic" }
      }
    }
  },
  "$defs": {
    "topic": {
      "description": "'no_data': not discussed, declined or not answerable (no rating, confidence or quotes). 'covered': 1-5 verbatim quotes and a confidence; rating 1 (very negative) to 5 (very positive) or null when not rateable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["no_data", "covered"] },
        "rating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "quotes": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      },
      "if": { "properties": { "status": { "const": "covered" } }, "required": ["status"] },
      "then": { "required": ["rating", "confidence", "quotes"], "properties": { "quotes": { "minItems": 1 } } },
      "else": { "not": { "anyOf": [ { "required": ["rating"] }, { "required": ["confidence"] }, { "required": ["quotes"] } ] } }
    }
  }
}

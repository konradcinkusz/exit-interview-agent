{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exit-interview-agent:schema:tile-writer-output:v1",
  "title": "Tile writer output, version 1",
  "description": "What the tile-writer model must return: one object holding the model-written tiles, nothing else. The Facts tile is never written by the model. Every tile names the topics it draws on in basedOn. Length and wording limits here are the schema's share of the checks; the agent's own guard (docs/architecture/draft-tiles.md) checks grounding, banned terms, PII and quote copying before any tile is shown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tiles"],
  "properties": {
    "tiles": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/tile" }
    }
  },
  "$defs": {
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "text", "basedOn"],
      "properties": {
        "kind": { "enum": ["overview", "what_worked", "what_could_improve", "for_the_next_person", "short_note"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "basedOn": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["onboarding", "management", "growth", "pay_vs_promises", "culture", "reason_for_leaving"] }
        }
      },
      "if": { "properties": { "kind": { "const": "short_note" } }, "required": ["kind"] },
      "then": { "properties": { "text": { "maxLength": 280 } } }
    }
  }
}

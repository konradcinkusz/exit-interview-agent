{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:exit-interview-agent:schema:tile-writer-output:v1",
  "title": "Tile writer output, version 1",
  "description": "What the tile-writer model must return: one object holding the model-written tiles, nothing else. The Facts tile is never written by the model. Every tile names the topics it draws on in basedOn. Length limits here are the schema's share of the checks: each kind has its own design limit (reddit 4500, glassdoor 900, google_review 500, short_note 280, the others 600). The agent's own guard (docs/architecture/draft-tiles.md, ADR-0075) checks grounding, banned terms, PII and quote copying before any tile is shown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tiles"],
  "properties": {
    "tiles": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/tile" }
    }
  },
  "$defs": {
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "text", "basedOn"],
      "properties": {
        "kind": { "enum": ["overview", "what_worked", "what_could_improve", "for_the_next_person", "short_note", "glassdoor", "google_review", "reddit"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4500 },
        "basedOn": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["onboarding", "management", "growth", "pay_vs_promises", "culture", "reason_for_leaving"] }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["overview", "what_worked", "what_could_improve", "for_the_next_person"] } }, "required": ["kind"] },
          "then": { "properties": { "text": { "maxLength": 600 } } } },
        { "if": { "properties": { "kind": { "const": "short_note" } }, "required": ["kind"] },
          "then": { "properties": { "text": { "maxLength": 280 } } } },
        { "if": { "properties": { "kind": { "const": "glassdoor" } }, "required": ["kind"] },
          "then": { "properties": { "text": { "maxLength": 900 } } } },
        { "if": { "properties": { "kind": { "const": "google_review" } }, "required": ["kind"] },
          "then": { "properties": { "text": { "maxLength": 500 } } } }
      ]
    }
  }
}

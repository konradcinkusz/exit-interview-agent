flowchart TB
    subgraph Browser
        B[Browser]
    end
    subgraph Web["web (Next.js, BFF)"]
        GATE["edge gate (proxy.ts)<br/>verifies JWT"]
        BFF["route handlers<br/>/api/auth/*, /api/config, /api/proxy/*"]
    end
    subgraph Svc["interview-service (.NET)"]
        API["/api/v1/* (web scheme)<br/>/mcp (MCP scheme, scope interview:submit)<br/>/.well-known/oauth-protected-resource<br/>/health, /alive"]
        DBX[("interviewdb")]
    end
    subgraph Auth["authservice (pinned image, own instance)"]
        AUTHAPI["/api/v1/auth/* (login, refresh, consents, account)<br/>JWKS, OAuth authorization server (MCP clients)"]
        AUTHDB[("authdb")]
    end
    B -->|"same origin only"| GATE --> BFF
    BFF -->|"login, refresh, consents, account (server side)"| AUTHAPI
    BFF -->|"bearer from HttpOnly cookie"| API
    API -->|"JWKS (validation only)"| AUTHAPI
    CL["Claude (MCP client)"] -->|"OAuth 2.1 + PKCE, then bearer"| AUTHAPI
    CL -->|"MCP tokens, aud = /mcp"| API
    API --> DBX
    AUTHAPI --> AUTHDB
    AH["AppHost (dev only)"] -.->|"composes"| Web
    AH -.-> Svc
    AH -.-> Auth
